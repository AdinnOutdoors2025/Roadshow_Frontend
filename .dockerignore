# Runtime-only image: send ONLY the host-built output to Docker.
# Everything else (src, node_modules, docs, tests, .git, …) is excluded.
*
!public
!.next/standalone
!.next/static

# env files copied into the standalone output by Next.js — never bake them in
# (runtime env comes from env_file / -e).
.next/standalone/.env
.next/standalone/.env.*
.next/standalone/.next/cache
