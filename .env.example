# =========================================================
# Roadshow frontend (Next.js) — environment variables
# Copy to .env and fill in real values. Never commit .env.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD
# time — never put a secret in a NEXT_PUBLIC_* variable, and rebuild
# after changing one. Variables without the prefix are server-only.
# =========================================================

# ---------- Backend API (public) ----------
# Base URL of the backend REST API. MUST end with "/"
# (calls are built as `${API_BASE}api/...`).
# Local: http://localhost:3001/   Live: https://<backend-host>/
NEXT_PUBLIC_API_BASE_LIVE=http://localhost:3001/
# Legacy name — only referenced by commented-out code in baseurl.js
NEXT_PUBLIC_API_BASE=http://localhost:3001/

# ---------- Site ----------
# Public site URL (used for images inside outgoing mails). No trailing slash.
# Local: http://localhost:3000   Live: https://www.adinnroadshows.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Analytics (public IDs; leave empty to disable) ----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# ---------- Third-party (public) ----------
# Vamosys public tracking iframe account id
NEXT_PUBLIC_VAMOSYS_USER_ID=
# Admin WhatsApp number (10 digits, no +91)
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=

# ---------- Business rules (public) ----------
NEXT_PUBLIC_MAX_DISCOUNT_PERCENT=15
NEXT_PUBLIC_DEFAULT_PROMOTER_CHARGE=1000
NEXT_PUBLIC_CAMPAIGN_HOURS_PER_DAY=8
NEXT_PUBLIC_DEFAULT_LOGIN_TIME=11:00
NEXT_PUBLIC_DEFAULT_LOGOUT_TIME=18:00
NEXT_PUBLIC_ABSENT_THRESHOLD_HOURS=4
# Legacy AuthContext session/idle timeouts (minutes)
NEXT_PUBLIC_SESSION_DURATION_MINUTES=120
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# ---------- Server-only (NOT exposed to the browser) ----------
# Shared secret sent as x-internal-secret to the backend's internal
# booking-summary endpoint. MUST equal the backend's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=
# Optional: backend URL as seen from the Next.js server (e.g. Docker
# service name). Falls back to NEXT_PUBLIC_API_BASE_LIVE when unset.
INTERNAL_API_BASE=
